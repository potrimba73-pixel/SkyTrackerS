# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/skytracker?retryWrites=true&w=majority

# Regioes (JSON array)
# Cada regiao: {name, lat, lon, radius_km, color}
REGIONS=[
  {"name":"Sesimbra","lat":38.4435,"lon":-9.1015,"radius_km":80,"color":"#ef4444"},
  {"name":"Setubal","lat":38.5244,"lon":-8.8882,"radius_km":60,"color":"#3b82f6"},
  {"name":"Lisboa","lat":38.7223,"lon":-9.1393,"radius_km":70,"color":"#22c55e"}
]

# Alertas - avioes especificos (separados por virgula)
ALERT_AIRCRAFT=TP1923,RYR1234,BA492,EZY1234

# Email SMTP (para notificacoes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=teuemail@gmail.com
SMTP_PASS=teu-app-password
SMTP_FROM=SkyTracker <teuemail@gmail.com>
ALERT_EMAIL=teuemail@gmail.com

# Intervalo de polling (segundos)
POLL_INTERVAL=30

# Limpeza de dados antigos (dias)
CLEANUP_DAYS=7
